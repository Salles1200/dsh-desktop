{
  "name": "dsh-simple-desktop",
  "version": "2.0.0",
  "description": "DSH plugin: a minimal native Windows desktop shell for the DeepSeek Harness web UI — desktop shortcut, WebView2 window, tray icon, single instance, high-DPI",
  "icon": "assets/icon.png",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "assets/icon.png",
    "assets/icon_blue.png",
    "assets/default-icon.png",
    "locale/en.json",
    "locale/zh.json",
    "bin/dsh-simple-desktop.exe",
    "bin/dsh-simple-desktop.exe.config",
    "bin/Microsoft.Web.WebView2.Core.dll",
    "bin/Microsoft.Web.WebView2.WinForms.dll",
    "bin/WebView2Loader.dll",
    "host/Program.cs",
    "host/app.config",
    "host/app.manifest"
  ],
  "engines": {
    "dsh": ">=0.1.5-rc.3 <0.2.0",
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Salles1200/dsh-simple-desktop.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
