# The prebuilt host lives in bin/ and is committed so users can install the
# plugin out of the box. Rebuild it with build.ps1 if you change host/Program.cs.

# NuGet download cache used by build.ps1
.tools/

# scratch directory for local host/plugin verification runs
.verify/

# host diagnostics written beside the exe when it is run from the repo
dsh-desktop.log

# locally generated runtime state (the plugin writes these under $DSH_HOME; a
# manual run from the repo root must not commit them either)
/dsh.ico
/dsh-desktop.conf
/manifest.json

# local installs / debug output
node_modules/
*.pdb

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
*.user
*.suo

# installable package tarball
*.tgz
